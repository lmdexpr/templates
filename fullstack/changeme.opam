opam-version: "2.0"
synopsis: "changeme"
maintainer: ["Yuki Tajiri <lmdexpr@gmail.com>"]
authors: ["Yuki Tajiri"]
license: "MIT"
homepage: "https://github.com/lmdexpr/changeme"
bug-reports: "https://github.com/lmdexpr/changeme/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.3"}
  "eio"
  "eio_main"
  "cohttp-eio"
  "tls-eio"
  "ca-certs"
  "mirage-crypto-rng-eio"
  "http"
  "logs"
  "uri"
  "ocaml-lsp-server" {with-dev-setup}
  "ocamlformat" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lmdexpr/changeme.git"
x-maintenance-intent: ["(latest)"]
